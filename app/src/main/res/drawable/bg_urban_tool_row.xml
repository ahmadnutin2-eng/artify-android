<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/surface_4" />
            <stroke android:width="1dp" android:color="@color/procreate_accent_light" />
        </shape>
    </item>
    <item android:state_selected="true" android:drawable="@drawable/bg_list_item_selected" />
    <item android:state_focused="true" android:drawable="@drawable/bg_list_item_selected" />
    <item android:drawable="@drawable/bg_list_item_ripple" />
</selector>
