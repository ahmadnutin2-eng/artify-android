<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawn as a foreground, over the frosted backdrop rather than under it.

    The hairline is what gives a pane of glass an edge. Carried on the background it would sit
    beneath the blurred snapshot and never be seen, so the panel would end in nothing.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
    <corners android:radius="18dp" />
</shape>
