<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gallery_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gallery_backdrop"
    tools:context=".ui.gallery.GalleryActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/background_darker"
        android:elevation="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:contentInsetStartWithNavigation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/gallery_title"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.App.GalleryTitle">

        <TextView
            android:id="@+id/btn_pro"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_gallery_tool"
            android:contentDescription="@string/pro_badge"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/pro_badge"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/gallery_header"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <TextView
            android:id="@+id/projects_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gallery_projects_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/entry_library"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_gallery_tool"
            android:clickable="true"
            android:contentDescription="@string/library_title"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/library_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_library"
            app:drawableTint="@color/icon_color" />

        <TextView
            android:id="@+id/entry_online"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gallery_tool"
            android:clickable="true"
            android:contentDescription="@string/online_title"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/online_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_online"
            app:drawableTint="@color/procreate_accent_light" />

        <TextView
            android:id="@+id/entry_urban"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gallery_tool"
            android:clickable="true"
            android:contentDescription="@string/entry_urban_title"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/entry_urban_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_urban_map"
            app:drawableTint="@color/icon_color" />

        <TextView
            android:id="@+id/entry_painting"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gallery_tool_primary"
            android:clickable="true"
            android:contentDescription="@string/new_artwork"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/new_artwork"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_plus"
            app:drawableTint="@color/white" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_gallery"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="15dp"
        android:paddingTop="4dp"
        android:paddingEnd="15dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gallery_header"
        tools:listitem="@layout/item_artwork" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gallery_header">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:alpha="0.72"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_palette"
            app:tint="@color/icon_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/gallery_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="@string/gallery_empty_hint"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
