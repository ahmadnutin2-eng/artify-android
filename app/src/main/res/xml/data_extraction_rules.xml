<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12 and above.

    Same intent as backup_rules.xml (which covers Android 11 and below): everything restores except
    the user's own AI API key. Both sections must be listed - cloud-backup and device-transfer are
    independent paths, and excluding the credential from only one would still send it off the device
    by the other.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="artify_ai_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="artify_ai_keys.xml" />
    </device-transfer>
</data-extraction-rules>
