<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Artify" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/procreate_accent</item>
        <item name="colorPrimaryVariant">@color/procreate_accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/procreate_accent</item>
        <item name="colorSecondaryVariant">@color/procreate_accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Surfaces: MaterialComponents defaults these to white, which is why bottom sheets,
             dialogs and spinners were rendering as light chrome against a dark app. Pin them
             to the dark palette so every stock Material widget inherits the right look. -->
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_darker</item>
        <item name="android:navigationBarColor">@color/background_darker</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Customizations -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheet</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- ===================== Bottom sheets ===================== -->
    <style name="ThemeOverlay.App.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
        <item name="colorSurface">@color/surface_1</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_1</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.BottomSheet</item>
        <item name="backgroundTint">@color/surface_1</item>
        <item name="android:elevation">12dp</item>
    </style>

    <style name="ShapeAppearance.App.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===================== Widgets ===================== -->
    <style name="Widget.App.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_progress</item>
        <item name="android:thumb">@drawable/seekbar_thumb</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
    </style>

    <style name="Widget.App.Button.Filled" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/procreate_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.App.Button.Flat" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field_outline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- ===================== Text appearances ===================== -->
    <style name="TextAppearance.App.PanelTitle" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.App.SectionLabel" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.App.GalleryTitle" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.App.RowLabel" parent="android:TextAppearance">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.App.RowValue" parent="android:TextAppearance">
        <item name="android:textColor">@color/procreate_accent_light</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Animation.App.SidePanel" parent="">
        <item name="android:windowEnterAnimation">@anim/slide_in_end</item>
        <item name="android:windowExitAnimation">@anim/slide_out_end</item>
    </style>

    <style name="Theme.Artify.SidePanel" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.12</item>
        <item name="android:windowAnimationStyle">@style/Animation.App.SidePanel</item>
        <item name="android:windowSoftInputMode">stateUnchanged</item>
    </style>
</resources>
